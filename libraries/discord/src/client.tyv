import "./gateway.tyv" as gateway

pub enum GatewayIntent {
    Guilds
    GuildMembers
    GuildModeration
    GuildExpressions
    GuildIntegrations
    GuildWebhooks
    GuildInvites
    GuildVoiceStates
    GuildPresences
    GuildMessages
    GuildMessageReactions
    GuildMessageTyping
    DirectMessages
    DirectMessageReactions
    DirectMessageTyping
    MessageContent
    GuildScheduledEvents
    AutoModerationConfiguration
    AutoModerationExecution
    GuildMessagePolls
    DirectMessagePolls
}

pub record GatewayRunSummary {
    ready: Bool
    sessionId: Option<String>
    resumeGatewayUrl: Option<String>
    lastSequence: Option<Int>
    dispatchCount: Int
    messageCount: Int
    heartbeatCount: Int
    recoveryAction: gateway.GatewayRecoveryAction
    recoveryReason: Option<String>
    closeCode: Option<Int>
    events: List<gateway.GatewayDispatch>
}

fn intentBit(intent: GatewayIntent) -> Int {
    match intent {
        GatewayIntent.Guilds => return 1
        GatewayIntent.GuildMembers => return 2
        GatewayIntent.GuildModeration => return 4
        GatewayIntent.GuildExpressions => return 8
        GatewayIntent.GuildIntegrations => return 16
        GatewayIntent.GuildWebhooks => return 32
        GatewayIntent.GuildInvites => return 64
        GatewayIntent.GuildVoiceStates => return 128
        GatewayIntent.GuildPresences => return 256
        GatewayIntent.GuildMessages => return 512
        GatewayIntent.GuildMessageReactions => return 1024
        GatewayIntent.GuildMessageTyping => return 2048
        GatewayIntent.DirectMessages => return 4096
        GatewayIntent.DirectMessageReactions => return 8192
        GatewayIntent.DirectMessageTyping => return 16384
        GatewayIntent.MessageContent => return 32768
        GatewayIntent.GuildScheduledEvents => return 65536
        GatewayIntent.AutoModerationConfiguration => return 1048576
        GatewayIntent.AutoModerationExecution => return 2097152
        GatewayIntent.GuildMessagePolls => return 16777216
        GatewayIntent.DirectMessagePolls => return 33554432
    }
    return 0
}

fn intentMask(intents: List<GatewayIntent>) -> Int {
    var mask: Int = 0
    let seen: List<GatewayIntent> = List<GatewayIntent>()
    for intent in intents {
        if !seen.contains(intent) {
            seen.append(intent)
            mask = mask + intentBit(intent)
        }
    }
    return mask
}

pub fn defaultIntents() -> List<GatewayIntent> {
    let intents: List<GatewayIntent> = List<GatewayIntent>()
    intents.append(GatewayIntent.Guilds)
    intents.append(GatewayIntent.GuildMessages)
    return intents
}

fn optionalString(object: Json, key: String) -> Option<String> {
    var result: Option<String> = None<String>()
    match object.objectGet(key) {
        Some(value) => result = value.asString()
        None => {}
    }
    return result
}

fn helloInterval(message: WebSocketMessage) -> Result<Int, String> {
    if message.kind() != "text" {
        return Err<Int, String>("Discord Gateway Hello must be a text message")
    }
    var result: Result<Int, String> = Err<Int, String>("invalid Discord Gateway Hello")
    match message.text() {
        Err(error) => result = Err<Int, String>(error)
        Ok(payload) => match gateway.decodeEnvelope(payload) {
            Err(error) => result = Err<Int, String>(error)
            Ok(envelope) => {
                if envelope.opcode != 10 {
                    result = Err<Int, String>("Discord Gateway expected Hello opcode 10")
                } else {
                    match envelope.data.objectGet("heartbeat_interval") {
                        Some(value) => match value.asInt() {
                            Some(interval) => {
                                if interval <= 0 || interval > 2147483647 {
                                    result = Err<Int, String>("Discord heartbeat interval is out of range")
                                } else {
                                    result = Ok<Int, String>(interval)
                                }
                            }
                            None => result = Err<Int, String>("Discord heartbeat_interval must be an integer")
                        }
                        None => result = Err<Int, String>("Discord Hello is missing heartbeat_interval")
                    }
                }
            }
        }
    }
    return result
}

fn heartbeatPayload(sequence: Option<Int>) -> Result<String, String> {
    let envelope: Map<String, Json> = Map<String, Json>()
    envelope.put("op", jsonInt(1))
    match sequence {
        Some(value) => envelope.put("d", jsonInt(value))
        None => envelope.put("d", jsonNull())
    }
    return jsonStringify(jsonObject(envelope))
}

fn identifyPayload(token: Secret<String>, intents: List<GatewayIntent>) -> Result<String, String> {
    let properties: Map<String, Json> = Map<String, Json>()
    properties.put("$os", jsonString(hostOS()))
    properties.put("$browser", jsonString("tyvera"))
    properties.put("$device", jsonString("tyvera"))

    let data: Map<String, Json> = Map<String, Json>()
    data.put("token", jsonString(token.reveal()))
    data.put("intents", jsonInt(intentMask(intents)))
    data.put("properties", jsonObject(properties))

    let envelope: Map<String, Json> = Map<String, Json>()
    envelope.put("op", jsonInt(2))
    envelope.put("d", jsonObject(data))
    return jsonStringify(jsonObject(envelope))
}

fn resumeConnectUrl(value: String) -> Result<String, String> {
    match webSocketUrl(value) {
        Err(_) => return Err<String, String>("Discord Gateway resume URL is invalid")
        Ok(url) => {
            let host = url.host()
            let trustedHost = host == "discord.gg" || url.hostEndsWith(".discord.gg")
            if url.scheme() != "wss" || url.port() != 443 || !trustedHost || url.target() != "/" {
                return Err<String, String>("Discord Gateway resume URL is not a trusted Gateway origin")
            }
            return Ok<String, String>("wss://" + host + "/?v=10&encoding=json")
        }
    }
    return Err<String, String>("Discord Gateway resume URL is invalid")
}

fn sessionCanResume(sessionId: Option<String>, resumeUrl: Option<String>, sequence: Option<Int>) -> Bool {
    var hasSession: Bool = false
    match sessionId {
        None => return false
        Some(_) => hasSession = true
    }
    match sequence {
        None => return false
        Some(_) => {}
    }
    match resumeUrl {
        None => return false
        Some(value) => match resumeConnectUrl(value) {
            Err(_) => return false
            Ok(_) => return hasSession
        }
    }
    return false
}

fn recoveryForClose(closeCode: Option<Int>, sessionId: Option<String>, resumeUrl: Option<String>, sequence: Option<Int>) -> gateway.GatewayRecoveryAction {
    return gateway.closeCodeAction(closeCode, sessionCanResume(sessionId, resumeUrl, sequence), false)
}

fn resumePayload(token: Secret<String>, sessionId: String, sequence: Int) -> Result<String, String> {
    let data: Map<String, Json> = Map<String, Json>()
    data.put("token", jsonString(token.reveal()))
    data.put("session_id", jsonString(sessionId))
    data.put("seq", jsonInt(sequence))
    let envelope: Map<String, Json> = Map<String, Json>()
    envelope.put("op", jsonInt(6))
    envelope.put("d", jsonObject(data))
    return jsonStringify(jsonObject(envelope))
}

fn retryableGatewayConnectError(error: String) -> Bool {
    if error == "WebSocket connect failed: DNS resolution failed" || error == "WebSocket connect failed: connection refused" || error == "WebSocket connect failed: connection reset" || error == "WebSocket connect failed: operation timed out" || error == "WebSocket connect failed: network operation failed" {
        return true
    }
    if error == "WebSocket handshake-write failed: connection reset" || error == "WebSocket handshake-write failed: operation timed out" || error == "WebSocket handshake-write failed: network operation failed" || error == "WebSocket handshake-read failed: connection reset" || error == "WebSocket handshake-read failed: operation timed out" || error == "WebSocket handshake-read failed: network operation failed" || error == "WebSocket server closed during handshake" {
        return true
    }
    if error == "WebSocket operation timed out" || error == "WebSocket operation failed: connection reset" || error == "WebSocket operation failed: network operation failed" || error == "WebSocket connection closed without a close frame" || error == "Discord Gateway closed before Hello" {
        return true
    }
    return false
}

fn retryableGatewaySessionTransportError(error: String) -> Bool {
    if error == "WebSocket operation failed: connection reset" || error == "WebSocket operation failed: network operation failed" || error == "WebSocket operation failed: operation timed out" || error == "WebSocket operation timed out" || error == "WebSocket connection closed without a close frame" || error == "WebSocket write failed: connection reset" || error == "WebSocket write failed: network operation failed" || error == "WebSocket write timed out" {
        return true
    }
    return false
}

// One transport session. Reconnect policy is kept in runGatewayReliable so
// the session itself remains bounded and its transitions are easy to test.
async fn runGatewaySession(token: Secret<String>, intents: List<GatewayIntent>, maxDispatches: Int, timeout: Duration, previous: Option<GatewayRunSummary>) -> Result<GatewayRunSummary, String> {
    if maxDispatches < 1 || maxDispatches > 10000 {
        return Err<GatewayRunSummary, String>("maxDispatches must be between 1 and 10000")
    }
    var connectUrl: String = "wss://gateway.discord.gg/?v=10&encoding=json"
    var shouldResume: Bool = false
    var sequence: Option<Int> = None<Int>()
    var sessionId: Option<String> = None<String>()
    var resumeUrl: Option<String> = None<String>()
    var ready: Bool = false
    var dispatches: Int = 0
    var messages: Int = 0
    var heartbeats: Int = 0
    var events: List<gateway.GatewayDispatch> = List<gateway.GatewayDispatch>()
    match previous {
        None => {}
        Some(prior) => {
            dispatches = prior.dispatchCount
            messages = prior.messageCount
            heartbeats = prior.heartbeatCount
            events = prior.events
            if prior.recoveryAction == gateway.GatewayRecoveryAction.Resume {
                match prior.sessionId {
                    None => return Err<GatewayRunSummary, String>("Discord Gateway session cannot be resumed without a session ID")
                    Some(value) => sessionId = Some(value)
                }
                match prior.lastSequence {
                    None => return Err<GatewayRunSummary, String>("Discord Gateway session cannot be resumed without a sequence")
                    Some(value) => sequence = Some(value)
                }
                match prior.resumeGatewayUrl {
                    None => return Err<GatewayRunSummary, String>("Discord Gateway session cannot be resumed without a resume URL")
                    Some(value) => match resumeConnectUrl(value) {
                        Err(error) => return Err<GatewayRunSummary, String>(error)
                        Ok(value) => {
                            connectUrl = value
                            shouldResume = true
                        }
                    }
                }
                ready = prior.ready
                resumeUrl = prior.resumeGatewayUrl
            }
        }
    }
    // Initial sessions use Discord's canonical origin; resume URLs are separately allowlisted.
    let opened = await webSocketConnect(connectUrl, timeout)
    match move opened {
        Err(error) => return Err<GatewayRunSummary, String>(error)
        Ok(connection) => {
            let hello = await connection.receiveWithin(timeout)
            match hello {
                Err(error) => {
                    connection.close()
                    return Err<GatewayRunSummary, String>(error)
                }
                Ok(value) => match value {
                    None => {
                        let earlyCloseCode = connection.closeCode()
                        let earlyAction = recoveryForClose(earlyCloseCode, sessionId, resumeUrl, sequence)
                        let earlyReason: Option<String> = Some("Discord Gateway closed before Hello")
                        connection.close()
                        if earlyAction == gateway.GatewayRecoveryAction.Fatal {
                            return Err<GatewayRunSummary, String>("Discord Gateway closed before Hello with a fatal status")
                        }
                        return Ok<GatewayRunSummary, String>(GatewayRunSummary(ready, sessionId, resumeUrl, sequence, dispatches, messages, heartbeats, earlyAction, earlyReason, earlyCloseCode, events))
                    }
                    Some(message) => match helloInterval(message) {
                        Err(error) => {
                            connection.close()
                            return Err<GatewayRunSummary, String>(error)
                        }
                        Ok(heartbeatInterval) => {
                            var initialPayload: Result<String, String> = Err<String, String>("invalid Discord Gateway session state")
                            if shouldResume {
                                match sessionId {
                                    None => {}
                                    Some(value) => match sequence {
                                        None => {}
                                        Some(lastSequence) => initialPayload = resumePayload(token, value, lastSequence)
                                    }
                                }
                            } else {
                                initialPayload = identifyPayload(token, intents)
                            }
                            match initialPayload {
                                Err(error) => {
                                    connection.close()
                                    return Err<GatewayRunSummary, String>(error)
                                }
                                Ok(payload) => {
                                    let identifySent = await connection.sendText(payload)
                                    match identifySent {
                                        Err(error) => {
                                            connection.close()
                                            return Err<GatewayRunSummary, String>(error)
                                        }
                                        Ok(_) => {}
                                    }
                                    var waitingForAck: Bool = false
                                    var failed: Option<String> = None<String>()
                                    var recoveryAction: gateway.GatewayRecoveryAction = gateway.GatewayRecoveryAction.Stop
                                    var recoveryReason: Option<String> = None<String>()
                                    var closeCode: Option<Int> = None<Int>()
                                    var active: Bool = true
                                    var nextHeartbeatAt: Int = monotonicMilliseconds() + heartbeatInterval
                                    while active && dispatches < maxDispatches {
                                        let now = monotonicMilliseconds()
                                        if now >= nextHeartbeatAt {
                                            if waitingForAck {
                                                recoveryAction = recoveryForClose(None<Int>(), sessionId, resumeUrl, sequence)
                                                recoveryReason = Some("Discord Gateway missed a heartbeat acknowledgement")
                                                active = false
                                            } else {
                                                waitingForAck = true
                                                heartbeats = heartbeats + 1
                                                match heartbeatPayload(sequence) {
                                                    Err(payloadError) => {
                                                        failed = Some(payloadError)
                                                        active = false
                                                    }
                                                    Ok(heartbeatMessage) => {
                                                        let heartbeatSent = await connection.sendText(heartbeatMessage)
                                                        match heartbeatSent {
                                                            Err(sendError) => {
                                                                failed = Some(sendError)
                                                                active = false
                                                            }
                                                            Ok(_) => {}
                                                        }
                                                    }
                                                }
                                            }
                                            nextHeartbeatAt = monotonicMilliseconds() + heartbeatInterval
                                        }
                                        if !active {
                                            continue
                                        }
                                        let waitMilliseconds = nextHeartbeatAt - monotonicMilliseconds()
                                        let incoming = await connection.receiveWithin(milliseconds(waitMilliseconds))
                                        match incoming {
                                            Err(error) => {
                                                if error == "WebSocket receive timed out" {
                                                    {}
                                                } else {
                                                    failed = Some(error)
                                                    active = false
                                                }
                                            }
                                            Ok(value) => match value {
                                                None => {
                                                    closeCode = connection.closeCode()
                                                    recoveryAction = recoveryForClose(closeCode, sessionId, resumeUrl, sequence)
                                                    recoveryReason = Some("Discord Gateway disconnected")
                                                    active = false
                                                }
                                                Some(frame) => {
                                                    if frame.kind() != "text" {
                                                        failed = Some("Discord Gateway sent a non-text payload")
                                                        active = false
                                                    } else {
                                                        match frame.text() {
                                                            Err(error) => {
                                                                failed = Some(error)
                                                                active = false
                                                            }
                                                            Ok(payload) => match gateway.decodeEnvelope(payload) {
                                                                Err(error) => {
                                                                    failed = Some(error)
                                                                    active = false
                                                                }
                                                                Ok(envelope) => {
                                                                    match envelope.sequence {
                                                                        Some(value) => sequence = Some(value)
                                                                        None => {}
                                                                    }
                                                                    if envelope.opcode == 1 {
                                                                        waitingForAck = true
                                                                        heartbeats = heartbeats + 1
                                                                        nextHeartbeatAt = monotonicMilliseconds() + heartbeatInterval
                                                                        match heartbeatPayload(sequence) {
                                                                            Err(payloadError) => {
                                                                                failed = Some(payloadError)
                                                                                active = false
                                                                            }
                                                                            Ok(heartbeatMessage) => {
                                                                                let heartbeatSent = await connection.sendText(heartbeatMessage)
                                                                                match heartbeatSent {
                                                                                    Err(sendError) => {
                                                                                        failed = Some(sendError)
                                                                                        active = false
                                                                                    }
                                                                                    Ok(_) => {}
                                                                                }
                                                                            }
                                                                        }
                                                                    } else if envelope.opcode == 11 {
                                                                        waitingForAck = false
                                                                    } else if envelope.opcode == 7 {
                                                                        recoveryAction = gateway.reconnectRequestAction(sessionCanResume(sessionId, resumeUrl, sequence))
                                                                        recoveryReason = Some("Discord Gateway requested a reconnect")
                                                                        active = false
                                                                    } else if envelope.opcode == 9 {
                                                                        match envelope.data.asBool() {
                                                                            None => {
                                                                                failed = Some("Discord Gateway Invalid Session payload must be a boolean")
                                                                                active = false
                                                                            }
                                                                            Some(resumable) => {
                                                                                recoveryAction = gateway.invalidSessionAction(resumable, sessionCanResume(sessionId, resumeUrl, sequence))
                                                                                recoveryReason = Some("Discord Gateway Invalid Session")
                                                                                active = false
                                                                            }
                                                                        }
                                                                    } else if envelope.opcode == 0 {
                                                                        dispatches = dispatches + 1
                                                                        match gateway.decodeDispatch(payload) {
                                                                            Err(error) => {
                                                                                failed = Some(error)
                                                                                active = false
                                                                            }
                                                                            Ok(event) => match event {
                                                                                gateway.GatewayDispatch.Ready(value) => {
                                                                                    events.append(event)
                                                                                    ready = true
                                                                                    sessionId = Some(value)
                                                                                    resumeUrl = optionalString(envelope.data, "resume_gateway_url")
                                                                                }
                                                                                gateway.GatewayDispatch.MessageCreate(_, _, _) => {
                                                                                    events.append(event)
                                                                                    messages = messages + 1
                                                                                }
                                                                                gateway.GatewayDispatch.Unknown(_) => events.append(event)
                                                                            }
                                                                        }
                                                                    } else if envelope.opcode != 10 {
                                                                        failed = Some("Discord Gateway sent an unsupported opcode")
                                                                        active = false
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    match failed {
                                        Some(error) => {
                                            connection.close()
                                            if retryableGatewaySessionTransportError(error) {
                                                recoveryAction = recoveryForClose(None<Int>(), sessionId, resumeUrl, sequence)
                                                recoveryReason = Some(error)
                                                return Ok<GatewayRunSummary, String>(GatewayRunSummary(ready, sessionId, resumeUrl, sequence, dispatches, messages, heartbeats, recoveryAction, recoveryReason, closeCode, events))
                                            }
                                            return Err<GatewayRunSummary, String>(error)
                                        }
                                        None => {
                                            if recoveryAction == gateway.GatewayRecoveryAction.Stop {
                                                let closed = await connection.closeGracefully()
                                                match closed {
                                                    Err(error) => return Err<GatewayRunSummary, String>(error)
                                                    Ok(_) => return Ok<GatewayRunSummary, String>(GatewayRunSummary(ready, sessionId, resumeUrl, sequence, dispatches, messages, heartbeats, recoveryAction, recoveryReason, closeCode, events))
                                                }
                                            }
                                            connection.close()
                                            return Ok<GatewayRunSummary, String>(GatewayRunSummary(ready, sessionId, resumeUrl, sequence, dispatches, messages, heartbeats, recoveryAction, recoveryReason, closeCode, events))
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return Err<GatewayRunSummary, String>("Discord Gateway session did not start")
}

pub async fn runGateway(token: Secret<String>, intents: List<GatewayIntent>, maxDispatches: Int, timeout: Duration) -> Result<GatewayRunSummary, String> {
    let result = await runGatewaySession(token, intents, maxDispatches, timeout, None<GatewayRunSummary>())
    return result
}

pub async fn runGatewayReliable(token: Secret<String>, intents: List<GatewayIntent>, maxDispatches: Int, timeout: Duration, maxReconnects: Int, baseBackoffMilliseconds: Int, maximumBackoffMilliseconds: Int) -> Result<GatewayRunSummary, String> {
    if maxDispatches < 1 || maxDispatches > 10000 {
        return Err<GatewayRunSummary, String>("maxDispatches must be between 1 and 10000")
    }
    if maxReconnects < 0 || maxReconnects > 32 {
        return Err<GatewayRunSummary, String>("maxReconnects must be between 0 and 32")
    }
    if baseBackoffMilliseconds < 0 || baseBackoffMilliseconds > 60000 || maximumBackoffMilliseconds < baseBackoffMilliseconds || maximumBackoffMilliseconds > 120000 {
        return Err<GatewayRunSummary, String>("Gateway backoff must be bounded between 0 and 120000 milliseconds")
    }
    var previous: Option<GatewayRunSummary> = None<GatewayRunSummary>()
    var reconnects: Int = 0
    var delay: Int = baseBackoffMilliseconds
    var active: Bool = true
    while active {
        let result = await runGatewaySession(token, intents, maxDispatches, timeout, previous)
        match result {
            Err(error) => {
                if !retryableGatewayConnectError(error) || reconnects >= maxReconnects {
                    return Err<GatewayRunSummary, String>(error)
                }
                let timer = sleepFor(milliseconds(delay))
                await timer
                reconnects = reconnects + 1
                if delay > 0 {
                    if delay > maximumBackoffMilliseconds / 2 {
                        delay = maximumBackoffMilliseconds
                    } else {
                        delay = delay * 2
                    }
                    if delay > maximumBackoffMilliseconds {
                        delay = maximumBackoffMilliseconds
                    }
                }
            }
            Ok(summary) => {
                if summary.dispatchCount >= maxDispatches || summary.recoveryAction == gateway.GatewayRecoveryAction.Stop {
                    return Ok<GatewayRunSummary, String>(summary)
                }
                if summary.recoveryAction == gateway.GatewayRecoveryAction.Fatal {
                    match summary.recoveryReason {
                        Some(error) => return Err<GatewayRunSummary, String>(error)
                        None => return Err<GatewayRunSummary, String>("Discord Gateway closed with a fatal status")
                    }
                }
                if reconnects >= maxReconnects {
                    return Err<GatewayRunSummary, String>("Discord Gateway reconnect limit exceeded")
                }
                let timer = sleepFor(milliseconds(delay))
                await timer
                previous = Some(summary)
                reconnects = reconnects + 1
                if delay > 0 {
                    if delay > maximumBackoffMilliseconds / 2 {
                        delay = maximumBackoffMilliseconds
                    } else {
                        delay = delay * 2
                    }
                    if delay > maximumBackoffMilliseconds {
                        delay = maximumBackoffMilliseconds
                    }
                }
            }
        }
    }
    return Err<GatewayRunSummary, String>("Discord Gateway reliability loop stopped unexpectedly")
}
