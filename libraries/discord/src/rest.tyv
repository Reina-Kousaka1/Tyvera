pub record RestFailure {
    status: Int
    code: Option<Int>
    message: String
    retryAfterSeconds: Option<Float>
    global: Bool
}

pub record DiscordRestResponse {
    status: Int
    body: Bytes
    rateLimitBucket: Option<String>
    rateLimitRemaining: Option<String>
    rateLimitResetAfter: Option<String>
    retryAfter: Option<String>
    globalRateLimit: Bool
}

fn responseFromHttp(response: HttpResponse) -> DiscordRestResponse {
    let headers = response.headers()
    var global: Bool = false
    match headers.get("x-ratelimit-global") {
        Some(value) => global = value == "true"
        None => {}
    }
    return DiscordRestResponse(response.status(), response.body(), headers.get("x-ratelimit-bucket"), headers.get("x-ratelimit-remaining"), headers.get("x-ratelimit-reset-after"), headers.get("retry-after"), global)
}

fn rateLimitRouteKey(routeTemplate: String, majorScope: String) -> String {
    return routeTemplate + "|" + majorScope
}

fn rateLimitRemainingFromHeader(header: Option<String>) -> Option<Int> {
    match header {
        None => return None<Int>()
        Some(value) => match parseJson(value) {
            Err(_) => return None<Int>()
            Ok(json) => match json.asInt() {
                Some(remaining) => {
                    if remaining < 0 {
                        return None<Int>()
                    }
                    return Some(remaining)
                }
                None => return None<Int>()
            }
        }
    }
    return None<Int>()
}

fn responseIsGlobalRateLimit(response: DiscordRestResponse) -> Bool {
    if response.globalRateLimit {
        return true
    }
    if response.status != 429 {
        return false
    }
    match response.body.toString() {
        Err(_) => return false
        Ok(text) => match parseJson(text) {
            Err(_) => return false
            Ok(root) => match root.objectGet("global") {
                None => return false
                Some(value) => match value.asBool() {
                    None => return false
                    Some(global) => return global
                }
            }
        }
    }
    return false
}

// Shared, bounded coordination for requests made with the same bot client.
// Bounded waiter tickets preserve FIFO order within each major scope while
// allowing independent scopes to proceed. Ticket IDs are never reused within
// one coordinator lifetime; completions must own the active ticket for a scope.
// Rate state remains conservative when
// Discord has independent buckets under one major resource.
pub actor DiscordRestRateLimitCoordinator {
    var routeBuckets: Map<String, String>
    var routeExpirations: Map<String, Int>
    var remainingByMajor: Map<String, Int>
    var resetAtByMajor: Map<String, Int>
    var blockedUntilByMajor: Map<String, Int>
    var stateExpirations: Map<String, Int>
    var activeUntilByMajor: Map<String, Int>
    var activeTicketByMajor: Map<String, Int>
    var waiterOrder: List<Int>
    var waiterScopes: Map<Int, String>
    var waiterExpiresAt: Map<Int, Int>
    var nextWaiterId: Int
    var globalBlockedUntil: Int

    init() {
        self.routeBuckets = Map<String, String>()
        self.routeExpirations = Map<String, Int>()
        self.remainingByMajor = Map<String, Int>()
        self.resetAtByMajor = Map<String, Int>()
        self.blockedUntilByMajor = Map<String, Int>()
        self.stateExpirations = Map<String, Int>()
        self.activeUntilByMajor = Map<String, Int>()
        self.activeTicketByMajor = Map<String, Int>()
        self.waiterOrder = List<Int>()
        self.waiterScopes = Map<Int, String>()
        self.waiterExpiresAt = Map<Int, Int>()
        self.nextWaiterId = 1
        self.globalBlockedUntil = 0
    }

    on reserveWaiter(majorScope: String, timeoutMilliseconds: Int, reply: ReplySender<Int>) {
        if majorScope == "" || timeoutMilliseconds <= 0 || timeoutMilliseconds > 605000 {
            reply.send(-1)
            return
        }
        let now = monotonicMilliseconds()
        var index: Int = 0
        while index < self.waiterOrder.length {
            match self.waiterOrder.get(index) {
                Some(ticket) => match self.waiterExpiresAt.get(ticket) {
                    Some(expiresAt) => {
                        if expiresAt <= now {
                            let removed = self.waiterOrder.removeAt(index)
                            self.waiterScopes.remove(ticket)
                            self.waiterExpiresAt.remove(ticket)
                        } else {
                            index = index + 1
                        }
                    }
                    None => {
                        let removed = self.waiterOrder.removeAt(index)
                        self.waiterScopes.remove(ticket)
                    }
                }
                None => index = index + 1
            }
        }
        if self.waiterOrder.length >= 512 {
            reply.send(-1)
            return
        }
        if self.nextWaiterId >= 2147483647 {
            reply.send(-1)
            return
        }
        let ticket = self.nextWaiterId
        self.nextWaiterId = self.nextWaiterId + 1
        self.waiterOrder.append(ticket)
        self.waiterScopes.put(ticket, majorScope)
        self.waiterExpiresAt.put(ticket, now + timeoutMilliseconds)
        reply.send(ticket)
    }

    on cancelWaiter(waiterId: Int, reply: ReplySender<Bool>) {
        var index: Int = 0
        var removedTicket: Bool = false
        while index < self.waiterOrder.length {
            match self.waiterOrder.get(index) {
                Some(ticket) => {
                    if ticket == waiterId {
                        let removed = self.waiterOrder.removeAt(index)
                        removedTicket = true
                        index = self.waiterOrder.length
                    } else {
                        index = index + 1
                    }
                }
                None => index = index + 1
            }
        }
        if removedTicket {
            self.waiterScopes.remove(waiterId)
            self.waiterExpiresAt.remove(waiterId)
        }
        reply.send(removedTicket)
    }

    on acquire(routeTemplate: String, majorScope: String, waiterId: Int, leaseMilliseconds: Int, reply: ReplySender<Int>) {
        if leaseMilliseconds <= 0 || leaseMilliseconds > 605000 {
            reply.send(-1)
            return
        }
        let now = monotonicMilliseconds()
        var waiterIndex: Int = 0
        while waiterIndex < self.waiterOrder.length {
            match self.waiterOrder.get(waiterIndex) {
                Some(ticket) => match self.waiterExpiresAt.get(ticket) {
                    Some(expiresAt) => {
                        if expiresAt <= now {
                            let removed = self.waiterOrder.removeAt(waiterIndex)
                            self.waiterScopes.remove(ticket)
                            self.waiterExpiresAt.remove(ticket)
                        } else {
                            waiterIndex = waiterIndex + 1
                        }
                    }
                    None => {
                        let removed = self.waiterOrder.removeAt(waiterIndex)
                        self.waiterScopes.remove(ticket)
                    }
                }
                None => waiterIndex = waiterIndex + 1
            }
        }
        var validTicket: Bool = false
        match self.waiterScopes.get(waiterId) {
            Some(scope) => validTicket = scope == majorScope
            None => {}
        }
        if !validTicket {
            reply.send(-2)
            return
        }
        var foundTicket: Bool = false
        var firstForScope: Bool = true
        for ticket in self.waiterOrder {
            if ticket == waiterId {
                foundTicket = true
                break
            }
            match self.waiterScopes.get(ticket) {
                Some(scope) => {
                    if scope == majorScope {
                        firstForScope = false
                    }
                }
                None => {}
            }
        }
        if !foundTicket {
            reply.send(-2)
            return
        }
        if !firstForScope {
            reply.send(50)
            return
        }
        let routeKeys = self.routeExpirations.keys()
        for routeKey in routeKeys {
            match self.routeExpirations.get(routeKey) {
                Some(expiresAt) => {
                    if expiresAt <= now {
                        self.routeExpirations.remove(routeKey)
                        self.routeBuckets.remove(routeKey)
                    }
                }
                None => {}
            }
        }
        let activeKeys = self.activeUntilByMajor.keys()
        for scope in activeKeys {
            match self.activeUntilByMajor.get(scope) {
                Some(until) => {
                    if until <= now {
                        self.activeUntilByMajor.remove(scope)
                        self.activeTicketByMajor.remove(scope)
                    }
                }
                None => {}
            }
        }
        let stateKeys = self.stateExpirations.keys()
        for scope in stateKeys {
            match self.stateExpirations.get(scope) {
                Some(expiresAt) => {
                    if expiresAt <= now && !self.activeUntilByMajor.containsKey(scope) {
                        self.stateExpirations.remove(scope)
                        self.remainingByMajor.remove(scope)
                        self.resetAtByMajor.remove(scope)
                        self.blockedUntilByMajor.remove(scope)
                    }
                }
                None => {}
            }
        }

        if self.globalBlockedUntil > now {
            reply.send(self.globalBlockedUntil - now)
            return
        }
        self.globalBlockedUntil = 0

        match self.blockedUntilByMajor.get(majorScope) {
            Some(until) => {
                if until > now {
                    reply.send(until - now)
                    return
                }
                self.blockedUntilByMajor.remove(majorScope)
            }
            None => {}
        }

        match self.activeUntilByMajor.get(majorScope) {
            Some(until) => {
                if until > now {
                    var waitMilliseconds = until - now
                    if waitMilliseconds > 50 {
                        waitMilliseconds = 50
                    }
                    reply.send(waitMilliseconds)
                    return
                }
                self.activeUntilByMajor.remove(majorScope)
                self.activeTicketByMajor.remove(majorScope)
            }
            None => {}
        }

        match self.resetAtByMajor.get(majorScope) {
            Some(resetAt) => {
                if resetAt > now {
                    match self.remainingByMajor.get(majorScope) {
                        Some(remaining) => {
                            if remaining <= 0 {
                                reply.send(resetAt - now)
                                return
                            }
                        }
                        None => {}
                    }
                } else {
                    self.resetAtByMajor.remove(majorScope)
                    self.remainingByMajor.remove(majorScope)
                    self.blockedUntilByMajor.remove(majorScope)
                }
            }
            None => {}
        }

        if !self.remainingByMajor.containsKey(majorScope) && self.remainingByMajor.length >= 512 {
            reply.send(-1)
            return
        }
        if self.activeUntilByMajor.length >= 512 {
            reply.send(-1)
            return
        }
        var removeIndex: Int = 0
        while removeIndex < self.waiterOrder.length {
            match self.waiterOrder.get(removeIndex) {
                Some(ticket) => {
                    if ticket == waiterId {
                        let removed = self.waiterOrder.removeAt(removeIndex)
                        removeIndex = self.waiterOrder.length
                    } else {
                        removeIndex = removeIndex + 1
                    }
                }
                None => removeIndex = removeIndex + 1
            }
        }
        self.waiterScopes.remove(waiterId)
        self.waiterExpiresAt.remove(waiterId)
        match self.remainingByMajor.get(majorScope) {
            Some(remaining) => {
                if remaining > 0 {
                    self.remainingByMajor.put(majorScope, remaining - 1)
                }
            }
            None => {}
        }
        self.activeUntilByMajor.put(majorScope, now + leaseMilliseconds)
        self.activeTicketByMajor.put(majorScope, waiterId)
        reply.send(0)
    }

    on complete(waiterId: Int, routeTemplate: String, majorScope: String, bucket: Option<String>, remaining: Option<Int>, resetDelayMilliseconds: Option<Int>, status: Int, globalLimit: Bool, retryDelayMilliseconds: Option<Int>, reply: ReplySender<Int>) {
        var ownsPermit: Bool = false
        match self.activeTicketByMajor.get(majorScope) {
            Some(activeTicket) => ownsPermit = activeTicket == waiterId
            None => {}
        }
        if !ownsPermit {
            reply.send(0)
            return
        }
        let now = monotonicMilliseconds()
        let routeKey = rateLimitRouteKey(routeTemplate, majorScope)
        self.activeUntilByMajor.remove(majorScope)
        self.activeTicketByMajor.remove(majorScope)

        match bucket {
            Some(bucketId) => {
                if self.routeBuckets.containsKey(routeKey) || self.routeBuckets.length < 512 {
                    self.routeBuckets.put(routeKey, bucketId)
                    self.routeExpirations.put(routeKey, now + 600000)
                }
            }
            None => {}
        }

        if status == 429 {
            var delayMilliseconds: Int = 1000
            match retryDelayMilliseconds {
                Some(value) => {
                    if value > 0 {
                        delayMilliseconds = value
                    }
                }
                None => {}
            }
            self.remainingByMajor.put(majorScope, 0)
            self.resetAtByMajor.put(majorScope, now + delayMilliseconds)
            self.blockedUntilByMajor.put(majorScope, now + delayMilliseconds)
            self.stateExpirations.put(majorScope, now + 600000)
            if globalLimit {
                let candidate = now + delayMilliseconds
                if candidate > self.globalBlockedUntil {
                    self.globalBlockedUntil = candidate
                }
            }
        } else {
            match remaining {
                Some(value) => {
                    self.remainingByMajor.put(majorScope, value)
                    match resetDelayMilliseconds {
                        Some(delay) => {
                            if delay > 0 {
                                self.resetAtByMajor.put(majorScope, now + delay)
                                if value == 0 {
                                    self.blockedUntilByMajor.put(majorScope, now + delay)
                                }
                            }
                        }
                        None => {
                            if value == 0 {
                                self.remainingByMajor.put(majorScope, 0)
                                self.resetAtByMajor.put(majorScope, now + 1000)
                                self.blockedUntilByMajor.put(majorScope, now + 1000)
                            }
                        }
                    }
                    self.stateExpirations.put(majorScope, now + 600000)
                }
                None => {
                    self.remainingByMajor.remove(majorScope)
                    self.resetAtByMajor.remove(majorScope)
                    self.stateExpirations.remove(majorScope)
                }
            }
        }
        reply.send(1)
    }

    on observedBucket(routeTemplate: String, majorScope: String, reply: ReplySender<Option<String>>) {
        reply.send(self.routeBuckets.get(rateLimitRouteKey(routeTemplate, majorScope)))
    }
}

pub fn newRestRateLimitCoordinator() -> ActorRef<DiscordRestRateLimitCoordinator> {
    return spawn(DiscordRestRateLimitCoordinator())
}

// Sends one request to the fixed, verified HTTPS Discord API origin. The
// endpoint is relative to /api/v10, so a caller cannot redirect the bot token
// to an arbitrary host. This primitive never retries: callers must apply an
// explicit, method-aware policy after inspecting the returned status/headers.
pub async fn requestBot(token: Secret<String>, methodName: String, endpoint: String, body: Bytes, timeout: Duration) -> Result<DiscordRestResponse, String> {
    let parsedUrl = httpUrl("https://discord.com/api/v10/" + endpoint)
    match parsedUrl {
        Err(_) => return Err<DiscordRestResponse, String>("invalid Discord API endpoint")
        Ok(url) => {
            if url.scheme() != "https" || url.host() != "discord.com" {
                return Err<DiscordRestResponse, String>("Discord REST requires the verified HTTPS API origin")
            }
            let parsedMethod = httpMethod(methodName)
            match parsedMethod {
                Err(_) => return Err<DiscordRestResponse, String>("invalid Discord REST method")
                Ok(method) => {
                    let headers = httpHeaders()
                    match headers.set("Authorization", "Bot " + token.reveal()) {
                        Err(_) => return Err<DiscordRestResponse, String>("could not prepare Discord REST authorization")
                        Ok(_) => {}
                    }
                    match headers.set("Accept", "application/json") {
                        Err(_) => return Err<DiscordRestResponse, String>("could not prepare Discord REST headers")
                        Ok(_) => {}
                    }
                    match headers.set("Content-Type", "application/json") {
                        Err(_) => return Err<DiscordRestResponse, String>("could not prepare Discord REST headers")
                        Ok(_) => {}
                    }
                    match httpRequest(method, url.target(), headers, body) {
                        Err(_) => return Err<DiscordRestResponse, String>("could not prepare Discord REST request")
                        Ok(request) => {
                            let sent = await httpSend(url, request, timeout)
                            match sent {
                                Err(_) => return Err<DiscordRestResponse, String>("Discord REST transport failed")
                                Ok(response) => return Ok<DiscordRestResponse, String>(responseFromHttp(response))
                            }
                        }
                    }
                }
            }
        }
    }
    return Err<DiscordRestResponse, String>("Discord REST request did not start")
}

async fn finishCoordinatedRateLimit(coordinator: ActorRef<DiscordRestRateLimitCoordinator>, waiterId: Int, routeTemplate: String, majorScope: String, response: Option<DiscordRestResponse>) {
    var bucket: Option<String> = None<String>()
    var remaining: Option<Int> = None<Int>()
    var resetDelayMilliseconds: Option<Int> = None<Int>()
    var retryDelayMilliseconds: Option<Int> = None<Int>()
    var status: Int = 0
    var globalLimit: Bool = false
    match response {
        Some(value) => {
            bucket = value.rateLimitBucket
            remaining = rateLimitRemainingFromHeader(value.rateLimitRemaining)
            status = value.status
            globalLimit = responseIsGlobalRateLimit(value)
            match boundedRetryDelayFromHeader(value.rateLimitResetAfter) {
                Some(delay) => resetDelayMilliseconds = Some<Int>(delay.inMilliseconds())
                None => {}
            }
            match boundedRetryDelay(value) {
                Some(delay) => retryDelayMilliseconds = Some<Int>(delay.inMilliseconds())
                None => {}
            }
        }
        None => {}
    }
    let completed = coordinator.request(complete, waiterId, routeTemplate, majorScope, bucket, remaining, resetDelayMilliseconds, status, globalLimit, retryDelayMilliseconds)
    let ignored = await completed
}

async fn cancelCoordinatedRateLimitWaiter(coordinator: ActorRef<DiscordRestRateLimitCoordinator>, waiterId: Int) {
    let cancellation = coordinator.request(cancelWaiter, waiterId)
    let ignored = await cancellation
}

pub async fn requestBotCoordinated(coordinator: ActorRef<DiscordRestRateLimitCoordinator>, routeTemplate: String, majorScope: String, token: Secret<String>, methodName: String, endpoint: String, body: Bytes, timeout: Duration) -> Result<DiscordRestResponse, String> {
    if routeTemplate == "" || majorScope == "" {
        return Err<DiscordRestResponse, String>("Discord REST rate-limit route and major scope must not be empty")
    }
    let timeoutMilliseconds = timeout.inMilliseconds()
    if timeoutMilliseconds <= 0 || timeoutMilliseconds > 600000 {
        return Err<DiscordRestResponse, String>("coordinated Discord REST timeout must be between 1 millisecond and 10 minutes")
    }
    let deadline = monotonicMilliseconds() + timeoutMilliseconds
    let reservation = coordinator.request(reserveWaiter, majorScope, timeoutMilliseconds + 5000)
    let waiterId = await reservation
    if waiterId <= 0 {
        return Err<DiscordRestResponse, String>("Discord REST rate-limit coordinator queue is full")
    }
    var acquired: Bool = false
    while !acquired {
        let budget = deadline - monotonicMilliseconds()
        if budget <= 0 {
            await cancelCoordinatedRateLimitWaiter(coordinator, waiterId)
            return Err<DiscordRestResponse, String>("Discord REST request timed out while waiting for a rate-limit permit")
        }
        let acquire = coordinator.request(acquire, routeTemplate, majorScope, waiterId, timeoutMilliseconds + 5000)
        let waitMilliseconds = await acquire
        if waitMilliseconds == -2 {
            await cancelCoordinatedRateLimitWaiter(coordinator, waiterId)
            return Err<DiscordRestResponse, String>("Discord REST rate-limit queue reservation expired or is invalid")
        }
        if waitMilliseconds < 0 {
            await cancelCoordinatedRateLimitWaiter(coordinator, waiterId)
            return Err<DiscordRestResponse, String>("Discord REST rate-limit coordinator capacity is exhausted")
        }
        if waitMilliseconds == 0 {
            acquired = true
        } else {
            let remainingBudget = deadline - monotonicMilliseconds()
            if remainingBudget <= 0 {
                await cancelCoordinatedRateLimitWaiter(coordinator, waiterId)
                return Err<DiscordRestResponse, String>("Discord REST request timed out while waiting for a rate-limit permit")
            }
            var waitSlice = waitMilliseconds
            if waitSlice > remainingBudget {
                waitSlice = remainingBudget
            }
            let timer = sleepFor(milliseconds(waitSlice))
            await timer
        }
    }
    let networkBudget = deadline - monotonicMilliseconds()
    if networkBudget <= 0 {
        await finishCoordinatedRateLimit(coordinator, waiterId, routeTemplate, majorScope, None<DiscordRestResponse>())
        return Err<DiscordRestResponse, String>("Discord REST request timed out before transport started")
    }
    let result = await requestBot(token, methodName, endpoint, body, milliseconds(networkBudget))
    match result {
        Err(error) => {
            await finishCoordinatedRateLimit(coordinator, waiterId, routeTemplate, majorScope, None<DiscordRestResponse>())
            return Err<DiscordRestResponse, String>(error)
        }
        Ok(response) => {
            await finishCoordinatedRateLimit(coordinator, waiterId, routeTemplate, majorScope, Some<DiscordRestResponse>(response))
            return Ok<DiscordRestResponse, String>(response)
        }
    }
    return Err<DiscordRestResponse, String>("Discord REST request did not complete")
}

pub async fn requestBotWithRetriesCoordinated(coordinator: ActorRef<DiscordRestRateLimitCoordinator>, routeTemplate: String, majorScope: String, token: Secret<String>, methodName: String, endpoint: String, body: Bytes, timeout: Duration, maxRetries: Int) -> Result<DiscordRestResponse, String> {
    if maxRetries < 0 || maxRetries > 5 {
        return Err<DiscordRestResponse, String>("Discord REST retry count must be between 0 and 5")
    }
    var retryCount: Int = 0
    while retryCount <= maxRetries {
        let result = await requestBotCoordinated(coordinator, routeTemplate, majorScope, token, methodName, endpoint, body, timeout)
        match result {
            Err(error) => return Err<DiscordRestResponse, String>(error)
            Ok(response) => {
                if response.status != 429 || retryCount == maxRetries {
                    return Ok<DiscordRestResponse, String>(response)
                }
                match boundedRetryDelay(response) {
                    None => return Ok<DiscordRestResponse, String>(response)
                    Some(delay) => {
                        let timer = sleepFor(delay)
                        await timer
                        retryCount = retryCount + 1
                    }
                }
            }
        }
    }
    return Err<DiscordRestResponse, String>("Discord REST coordinated retry loop stopped unexpectedly")
}

fn boundedRetryDelayFromSeconds(retryDelaySeconds: Float) -> Option<Duration> {
    if retryDelaySeconds < 0.0 || retryDelaySeconds > 120.0 {
        return None<Duration>()
    }
    match durationFromSeconds(retryDelaySeconds) {
        Err(_) => return None<Duration>()
        Ok(delay) => return Some(delay)
    }
    return None<Duration>()
}

fn boundedRetryDelayFromHeader(header: Option<String>) -> Option<Duration> {
    match header {
        None => return None<Duration>()
        Some(value) => match parseJson(value) {
            Err(_) => return None<Duration>()
            Ok(json) => match json.asFloat() {
                Some(retryDelaySeconds) => return boundedRetryDelayFromSeconds(retryDelaySeconds)
                None => match json.asInt() {
                    None => return None<Duration>()
                    Some(retryDelaySeconds) => {
                        if retryDelaySeconds < 0 || retryDelaySeconds > 120 {
                            return None<Duration>()
                        }
                        return Some(seconds(retryDelaySeconds))
                    }
                }
            }
        }
    }
    return None<Duration>()
}

fn boundedRetryDelay(response: DiscordRestResponse) -> Option<Duration> {
    match response.body.toString() {
        Err(_) => return boundedRetryDelayFromHeader(response.retryAfter)
        Ok(text) => match decodeFailure(response.status, text) {
            Err(_) => return boundedRetryDelayFromHeader(response.retryAfter)
            Ok(failure) => match failure.retryAfterSeconds {
                None => return boundedRetryDelayFromHeader(response.retryAfter)
                Some(retryDelaySeconds) => return boundedRetryDelayFromSeconds(retryDelaySeconds)
            }
        }
    }
    return None<Duration>()
}

// Retries only an explicit Discord 429 rejection. Transport failures and
// other HTTP statuses are returned unchanged, so side-effecting operations
// are never replayed after an ambiguous network failure. This per-call policy
// is bounded; shared bucket/global coordination is not implemented yet.
pub async fn requestBotWithRetries(token: Secret<String>, methodName: String, endpoint: String, body: Bytes, timeout: Duration, maxRetries: Int) -> Result<DiscordRestResponse, String> {
    if maxRetries < 0 || maxRetries > 5 {
        return Err<DiscordRestResponse, String>("Discord REST retry count must be between 0 and 5")
    }
    var retryCount: Int = 0
    while retryCount <= maxRetries {
        let result = await requestBot(token, methodName, endpoint, body, timeout)
        match result {
            Err(error) => return Err<DiscordRestResponse, String>(error)
            Ok(response) => {
                if response.status != 429 || retryCount == maxRetries {
                    return Ok<DiscordRestResponse, String>(response)
                }
                match boundedRetryDelay(response) {
                    None => return Ok<DiscordRestResponse, String>(response)
                    Some(delay) => {
                        let timer = sleepFor(delay)
                        await timer
                        retryCount = retryCount + 1
                    }
                }
            }
        }
    }
    return Err<DiscordRestResponse, String>("Discord REST retry loop stopped unexpectedly")
}

// Converts an unsuccessful HTTP response into the existing typed Discord
// API failure record. Successful 2xx responses produce None. The raw response
// remains available to callers for endpoint-specific decoding.
pub fn decodeResponseFailure(response: DiscordRestResponse) -> Result<Option<RestFailure>, String> {
    if response.status >= 200 && response.status < 300 {
        return Ok<Option<RestFailure>, String>(None<RestFailure>())
    }
    match response.body.toString() {
        Err(error) => return Err<Option<RestFailure>, String>(error)
        Ok(text) => match decodeFailure(response.status, text) {
            Err(error) => return Err<Option<RestFailure>, String>(error)
            Ok(failure) => return Ok<Option<RestFailure>, String>(Some(failure))
        }
    }
    return Err<Option<RestFailure>, String>("invalid Discord REST response")
}

fn requiredString(object: Json, key: String) -> Result<String, String> {
    var result: Result<String, String> = Err<String, String>("REST error field is missing")
    match object.objectGet(key) {
        Some(value) => match value.asString() {
            Some(text) => result = Ok<String, String>(text)
            None => result = Err<String, String>("REST error field must be a string")
        }
        None => {}
    }
    return result
}

fn optionalInt(object: Json, key: String) -> Result<Option<Int>, String> {
    var result: Result<Option<Int>, String> = Ok<Option<Int>, String>(None<Int>())
    match object.objectGet(key) {
        Some(value) => match value.asInt() {
            Some(number) => result = Ok<Option<Int>, String>(Some(number))
            None => result = Err<Option<Int>, String>("REST error code must be an integer")
        }
        None => {}
    }
    return result
}

fn optionalRetryAfter(object: Json) -> Result<Option<Float>, String> {
    var result: Result<Option<Float>, String> = Ok<Option<Float>, String>(None<Float>())
    match object.objectGet("retry_after") {
        Some(value) => match value.asFloat() {
            Some(retryDelay) => {
                if retryDelay < 0.0 {
                    result = Err<Option<Float>, String>("retry_after must not be negative")
                } else {
                    result = Ok<Option<Float>, String>(Some(retryDelay))
                }
            }
            None => result = Err<Option<Float>, String>("retry_after must be a floating-point number")
        }
        None => {}
    }
    return result
}

fn optionalGlobal(object: Json) -> Result<Bool, String> {
    var result: Result<Bool, String> = Ok<Bool, String>(false)
    match object.objectGet("global") {
        Some(value) => match value.asBool() {
            Some(enabled) => result = Ok<Bool, String>(enabled)
            None => result = Err<Bool, String>("global must be a boolean")
        }
        None => {}
    }
    return result
}

pub fn decodeFailure(status: Int, body: String) -> Result<RestFailure, String> {
    var result: Result<RestFailure, String> = Err<RestFailure, String>("invalid Discord REST error response")
    if status < 100 || status > 599 {
        return result
    }
    match parseJson(body) {
        Ok(root) => {
            match requiredString(root, "message") {
                Ok(message) => match optionalInt(root, "code") {
                    Ok(code) => match optionalRetryAfter(root) {
                        Ok(retryAfter) => match optionalGlobal(root) {
                            Ok(isGlobal) => {
                                if status == 429 {
                                    match retryAfter {
                                        Some(_) => result = Ok<RestFailure, String>(RestFailure(status, code, message, retryAfter, isGlobal))
                                        None => result = Err<RestFailure, String>("rate-limit response is missing retry_after")
                                    }
                                } else {
                                    result = Ok<RestFailure, String>(RestFailure(status, code, message, retryAfter, isGlobal))
                                }
                            }
                            Err(_) => {}
                        }
                        Err(_) => {}
                    }
                    Err(_) => {}
                }
                Err(_) => {}
            }
        }
        Err(_) => {}
    }
    return result
}
