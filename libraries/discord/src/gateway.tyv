pub enum GatewayDispatch {
    Ready(String)
    MessageCreate(String, String, String)
    Unknown(String)
}

pub record GatewayEnvelope {
    opcode: Int
    sequence: Option<Int>
    eventName: Option<String>
    data: Json
}

fn requiredString(object: Json, key: String) -> Result<String, String> {
    var result: Result<String, String> = Err<String, String>("gateway field is missing")
    match object.objectGet(key) {
        Some(value) => match value.asString() {
            Some(text) => result = Ok<String, String>(text)
            None => result = Err<String, String>("gateway field must be a string")
        }
        None => {}
    }
    return result
}

pub fn decodeDispatch(payload: String) -> Result<GatewayDispatch, String> {
    var result: Result<GatewayDispatch, String> = Err<GatewayDispatch, String>("invalid gateway JSON payload")
    match parseJson(payload) {
        Ok(root) => {
            match requiredString(root, "t") {
                Ok(eventName) => match root.objectGet("d") {
                Some(data) => {
                    if eventName == "READY" {
                        match requiredString(data, "session_id") {
                            Ok(sessionId) => result = Ok<GatewayDispatch, String>(GatewayDispatch.Ready(sessionId))
                            Err(error) => result = Err<GatewayDispatch, String>(error)
                        }
                    } else if eventName == "MESSAGE_CREATE" {
                        match requiredString(data, "id") {
                            Ok(messageId) => match requiredString(data, "channel_id") {
                                Ok(channelId) => match requiredString(data, "content") {
                                    Ok(content) => result = Ok<GatewayDispatch, String>(GatewayDispatch.MessageCreate(messageId, channelId, content))
                                    Err(error) => result = Err<GatewayDispatch, String>(error)
                                }
                                Err(error) => result = Err<GatewayDispatch, String>(error)
                            }
                            Err(error) => result = Err<GatewayDispatch, String>(error)
                        }
                    } else {
                        result = Ok<GatewayDispatch, String>(GatewayDispatch.Unknown(eventName))
                    }
                }
                None => result = Err<GatewayDispatch, String>("gateway dispatch data is missing")
            }
                Err(error) => result = Err<GatewayDispatch, String>(error)
            }
        }
        Err(_) => {}
    }
    return result
}

pub fn decodeEnvelope(payload: String) -> Result<GatewayEnvelope, String> {
    var result: Result<GatewayEnvelope, String> = Err<GatewayEnvelope, String>("invalid gateway envelope")
    match parseJson(payload) {
        Ok(root) => match root.objectGet("op") {
            Some(opValue) => match opValue.asInt() {
                Some(opcode) => {
                    var sequence: Option<Int> = None<Int>()
                    var eventName: Option<String> = None<String>()
                    var data: Json = jsonNull()
                    var valid: Bool = true
                    match root.objectGet("s") {
                        Some(sequenceValue) => {
                            if !sequenceValue.isNull() {
                                match sequenceValue.asInt() {
                                    Some(value) => sequence = Some(value)
                                    None => valid = false
                                }
                            }
                        }
                        None => {}
                    }
                    match root.objectGet("t") {
                        Some(eventValue) => {
                            if !eventValue.isNull() {
                                match eventValue.asString() {
                                    Some(value) => eventName = Some(value)
                                    None => valid = false
                                }
                            }
                        }
                        None => {}
                    }
                    match root.objectGet("d") {
                        Some(value) => data = value
                        None => {}
                    }
                    if valid {
                        result = Ok<GatewayEnvelope, String>(GatewayEnvelope(opcode, sequence, eventName, data))
                    } else {
                        result = Err<GatewayEnvelope, String>("gateway sequence or event name has the wrong type")
                    }
                }
                None => result = Err<GatewayEnvelope, String>("gateway opcode must be an integer")
            }
            None => result = Err<GatewayEnvelope, String>("gateway opcode is missing")
        }
        Err(_) => {}
    }
    return result
}
