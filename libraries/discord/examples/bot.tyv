import "../src/client.tyv" as discord
import "../src/gateway.tyv" as gateway

async fn runGateway(token: Secret<String>, reply: ReplySender<Int>) {
    let result = await discord.runGatewayReliable(token, discord.defaultIntents(), 1000, seconds(15), 3, 250, 5000)
    match result {
        Err(error) => {
            eprintln(error)
            reply.send(-1)
        }
        Ok(summary) => {
            println(summary.ready)
            println(summary.dispatchCount)
            println(summary.messageCount)
            println(summary.heartbeatCount)
            for event in summary.events {
                match event {
                    gateway.GatewayDispatch.Ready(_) => println("Gateway session ready")
                    gateway.GatewayDispatch.MessageCreate(_, channelId, _) => println("Message event in " + channelId)
                    gateway.GatewayDispatch.Unknown(name) => println("Ignored event " + name)
                }
            }
            reply.send(summary.dispatchCount)
        }
    }
}

actor GatewayRunner {
    on run(reply: ReplySender<Int>) {
        match environment("DISCORD_TOKEN") {
            None => {
                println("Set DISCORD_TOKEN to run the experimental Discord Gateway client.")
                reply.send(-1)
            }
            Some(token) => {
                let task = runGateway(token, reply)
            }
        }
    }
}

async fn runSupervisedGateway() {
    let supervisor = oneForOne(2, 1000)
    let runner = supervisor.start(GatewayRunner(), transientChildPolicy())
    let pending = runner.request(run)
    let dispatchCount: Int = await pending
    runner.stop()
}

fn main() {
    let task = runSupervisedGateway()
    match runTasks() {
        Ok(_) => {}
        Err(error) => eprintln(error)
    }
}
