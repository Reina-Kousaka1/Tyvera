import "../src/client.tyv" as discord
import "../src/gateway.tyv" as gateway

async fn startGateway(token: Secret<String>) {
    let result = await discord.runGatewayReliable(token, discord.defaultIntents(), 1000, seconds(15), 3, 250, 5000)
    match result {
        Err(error) => eprintln(error)
        Ok(summary) => {
            println(summary.ready)
            println(summary.dispatchCount)
            println(summary.messageCount)
            println(summary.heartbeatCount)
            for event in summary.events {
                match event {
                    gateway.GatewayDispatch.Ready(_) => println("Gateway session ready")
                    gateway.GatewayDispatch.MessageCreate(_, channelId, _) => println("Message event in " + channelId)
                    gateway.GatewayDispatch.Unknown(name) => println("Ignored event " + name)
                }
            }
        }
    }
}

fn main() {
    match environment("DISCORD_TOKEN") {
        None => println("Set DISCORD_TOKEN to run the experimental Discord Gateway client.")
        Some(token) => {
            let task = startGateway(token)
            match runTasks() {
                Ok(_) => {}
                Err(error) => eprintln(error)
            }
        }
    }
}
